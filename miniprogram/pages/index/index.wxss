.page-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: #788291;
  font-size: 28rpx;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef4fb 0%, #f5f8fc 240rpx, #f5f8fc 100%);
}

.page-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 20rpx 32rpx 0;
}

.page-bottom-spacer {
  height: calc(152rpx + env(safe-area-inset-bottom));
}

.hero {
  margin-bottom: 28rpx;
}

.brand {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #4878c8;
  letter-spacing: 4rpx;
  line-height: 1.4;
}

.date {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1e2834;
  margin-top: 8rpx;
  line-height: 1.25;
}

.subtitle {
  display: block;
  color: #5a6676;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}

.composer {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 40, 52, 0.06);
  border: 1rpx solid rgba(210, 218, 230, 0.9);
}

.input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1e2834;
}

.input-ph {
  color: #9aa5b5;
}

.btn-primary {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 80rpx;
  margin-left: 8rpx;
  padding: 0 28rpx;
  background: linear-gradient(135deg, #5a94e8 0%, #4882dc 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(72, 130, 220, 0.35);
}

.toolbar {
  margin-bottom: 16rpx;
}

.toolbar-row {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.toolbar-row + .toolbar-row {
  margin-top: 8rpx;
}

.chip {
  margin: 6rpx;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  border: 1rpx solid #d2dae6;
  background: #fff;
  color: #3d4a5c;
  box-shadow: 0 2rpx 8rpx rgba(30, 40, 52, 0.04);
}

.chip-active {
  background: #28303a;
  color: #fff;
  border-color: #28303a;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(40, 48, 58, 0.25);
}

.chip-ghost {
  background: #f8fafd;
}

.counts-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.counts {
  font-size: 22rpx;
  color: #788291;
}

.list {
  min-height: 200rpx;
  background: #fff;
  border: 1rpx solid #d2dae6;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(30, 40, 52, 0.05);
  overflow: hidden;
}

.empty {
  padding: 48rpx 32rpx;
  text-align: center;
  color: #9aa5b5;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty text {
  display: block;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.row:last-child {
  border-bottom: none;
}

.row-selected {
  background: #f0f4fa;
}

.check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  margin-right: 16rpx;
  border-radius: 10rpx;
  border: 2rpx solid #c5ced9;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  box-sizing: border-box;
}

.check-done {
  background: #4882dc;
  border-color: #4882dc;
}

.row-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.45;
  color: #1e2834;
  padding-top: 2rpx;
  word-break: break-word;
}

.row-text-done {
  color: #9aa5b5;
  text-decoration: line-through;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(245, 248, 252, 0.98);
  border-top: 1rpx solid rgba(210, 218, 230, 0.8);
  box-shadow: 0 -6rpx 20rpx rgba(30, 40, 52, 0.05);
}

.btn-outline {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 22rpx 0;
  margin-right: 12rpx;
  border: 1rpx solid #d2dae6;
  border-radius: 12rpx;
  background: #fff;
  color: #3d4a5c;
  box-shadow: 0 2rpx 8rpx rgba(30, 40, 52, 0.04);
}

.btn-outline:last-child {
  margin-right: 0;
}

.btn-outline-danger {
  color: #c45c5c;
  border-color: #e8c4c4;
  background: #fffafa;
}
